FFXIV_VENUES_WEBHOOKSERVICE__Serilog__MinimumLevel__Default=Information
FFXIV_VENUES_WEBHOOKSERVICE__Serilog__MinimumLevel__Override__System.Net.Http.HttpClient=Warning

FFXIV_VENUES_WEBHOOKSERVICE__ConnectionStrings__FFXIVVenues=Host=FFXIVVenues.Api.Postgres;Port=5432;Username=postgres;Password=${POSTGRES_PASSWORD};Database=ffxivvenues

FFXIV_VENUES_WEBHOOKSERVICE__Rabbit__ServiceUrl=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@FFXIVVenues.RabbitMQ:5672

FFXIV_VENUES_WEBHOOKSERVICE__BannerUriTemplate=${API_PUBLIC_URI}/venue/{venueId}/media

FFXIV_VENUES_WEBHOOKSERVICE__Signing__PrivateKeyPath=config/private.pem

FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Name=Allegro
FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Url=https://api.frogge.tech/webhooks/ffxivvenues/venue
FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Events__0=com.ffxivvenues.venue.created
FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Events__1=com.ffxivvenues.venue.updated
FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Events__2=com.ffxivvenues.venue.deleted
FFXIV_VENUES_WEBHOOKSERVICE__WebHooks__0__Comment=
