FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Default=Information
FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Routing.EndpointMiddleware=Warning
FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Routing=Warning
FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Cors=Warning
FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Mvc=Warning
FFXIV_VENUES_OGCARD__Serilog__MinimumLevel__Override__Microsoft.AspNetCore.StaticFiles=Warning

FFXIV_VENUES_OGCARD__ConnectionStrings__FFXIVVenues=Host=FFXIVVenues.Api.Postgres;Port=5432;Username=postgres;Password=${POSTGRES_PASSWORD};Database=ffxivvenues
FFXIV_VENUES_OGCARD__RedirectUriTemplate=${UI_PUBLIC_URI}/venue/{venueId}
FFXIV_VENUES_OGCARD__BannerUriTemplate=${API_PUBLIC_URI}/venue/{venueId}/media
